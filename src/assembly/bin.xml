<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <!-- The platform profile in pom.xml sets platform, archive.format, launcher, and launcher.line.ending -->
    <id>${platform}</id>
    <formats>
        <format>${archive.format}</format>
        <!-- An unpacked copy for LauncherIT -->
        <format>dir</format>
    </formats>
    <baseDirectory>ronja-${project.version}</baseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory/>
            <includes>
                <include>README.md</include>
                <include>LICENSE</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory/>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}/scripts</directory>
            <outputDirectory/>
            <excludes>
                <exclude>ronja.bat</exclude>
                <exclude>ronja</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}/scripts</directory>
            <outputDirectory/>
            <fileMode>0775</fileMode>
            <includes>
                <include>${launcher}</include>
            </includes>
            <lineEnding>${launcher.line.ending}</lineEnding>
        </fileSet>
        <fileSet>
            <directory>${runtime.dir}</directory>
            <outputDirectory>runtime</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
